# --- AI features (chapter Q&A, quiz, discussion) ---
# Backend: Kimi (Moonshot), used through its OpenAI-compatible API.
KIMI_API_KEY=your-key-here
# API endpoint (required, e.g. https://<host>/v1) — must match the one your key
# is provisioned for; see the Moonshot console. There is no built-in default.
KIMI_BASE_URL=
# Model id used by all AI routes. Defaults to "kimi-k3" when unset.
KIMI_MODEL=kimi-k3

# --- AI request guard (src/lib/ai-guard.ts) ---
# Comma-separated list of allowed cross-origin hosts/origins for the AI routes.
# Same-origin browser requests are always allowed; add any extra origins here
# (e.g. a separate front-end domain). Accepts "https://foo.com" or "foo.com".
ALLOWED_ORIGINS=

# Optional shared secret. When set, every AI request must send a matching
# "x-ai-token" header, otherwise it is rejected with 401. Leave blank to disable.
AI_ACCESS_TOKEN=

# Daily cap on total (input + output) tokens across all AI routes. Once exceeded,
# requests are rejected with 429 until the next UTC day. Defaults to 5000000.
# NOTE: counted per server process (in-memory) — use Redis for multi-instance.
AI_DAILY_TOKEN_CAP=5000000

# --- Meilisearch (self-hosted search) ---
# Frontend (public, search-only key + host):
NEXT_PUBLIC_MEILI_HOST=
NEXT_PUBLIC_MEILI_SEARCH_KEY=
NEXT_PUBLIC_MEILI_INDEX=permissionless-finance
# Indexer only (keep secret): the admin/master key
MEILI_HOST=http://localhost:7700
MEILI_ADMIN_KEY=
MEILI_INDEX=permissionless-finance
